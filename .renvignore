# This is a big ol' complex project with lots of things that {renv} doesn't
# actually need to look at, so I have it ignore everything by default
*

# Don't ignore these things
!*/
!*.qmd
!*.R
!*.Rmd
!.Rprofile
!_quarto.yml
!*.Rproj
!renv.lock
!DESCRIPTION
!NAMESPACE

# Don't ever really worry about checking these folders
_site/
_extensions/
_freeze/
.quarto/
*_cache/
*_files/
etc/
